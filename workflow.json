      "parameters": {
        "jsCode": "const now = Date.now();\nreturn $input.all().filter(i => {\n  const r = i.json;\n  const active = ['New', 'Contacted'].includes(r.status);\n  const step = Number(r.step || 0);\n  const due = !r.next_send || new Date(r.next_send).getTime() <= now;\n  return r.email && active && step < 3 && due;\n});"
